          "content": {
            "size": 3613,
            "mimeType": "text/css",
            "text": "/*Button*/\r\n/*Normal::after btn btn-warning btn-normal\r\nBlue::after btn btn-primary btn-blue\r\nGreen::after btn btn-success btn-green*/\r\n\r\n.btn-normal {\r\n    font-weight: bold;\r\n    background-color: #F2994A;\r\n    border-color: #F2994A;\r\n    transition: all 0.2s ease-in-out;\r\n    color: white;\r\n}\r\n\r\n.btn-normal:hover {\r\n    background-color: #f27323;\r\n    border-color: #f27323;\r\n    color: white;\r\n}\r\n\r\n.btn-normal:active {\r\n    background-color: #f27323 !important;\r\n    border-color: #f27323 !important;\r\n    color: white !important;\r\n}\r\n\r\n.btn-inactive {\r\n    font-weight: bold;\r\n    background-color: #ddb694;\r\n    border-color: #ddb694;\r\n    transition: all 0.2s ease-in-out;\r\n    color: white;\r\n}\r\n\r\n.btn-inactive:hover {\r\n    background-color: #ddab94;\r\n    border-color: #ddab94;\r\n    color: white;\r\n}\r\n\r\n.btn-inactive:active {\r\n    background-color: #ddab94 !important;\r\n    border-color: #ddab94 !important;\r\n    color: white !important;\r\n}\r\n\r\n.btn-blue {\r\n    font-weight: bold;\r\n    background-color: #08c;\r\n    border-color: #08c;\r\n    transition: all 0.2s ease-in-out;\r\n    color: white;\r\n}\r\n\r\n.btn-blue:disabled,\r\n.btn-blue[disabled] {\r\n    border: 1px solid #999999;\r\n    background-color: #cccccc;\r\n    color: #666666;\r\n}\r\n\r\n.btn-green {\r\n    font-weight: bold;\r\n    background-color: #23ac68;\r\n    border-color: #23ac68;\r\n    transition: all 0.2s ease-in-out;\r\n    color: white;\r\n}\r\n\r\n.btn-green:disabled,\r\n.btn-green[disabled] {\r\n    border: 1px solid #999999;\r\n    background-color: #cccccc;\r\n    color: #666666;\r\n}\r\n\r\n.btn-danger:disabled,\r\n.btn-danger[disabled] {\r\n    border: 1px solid #999999;\r\n    background-color: #cccccc;\r\n    color: #666666;\r\n}\r\n\r\n.btn-warning:disabled,\r\n.btn-warning[disabled] {\r\n    border: 1px solid #999999;\r\n    background-color: #cccccc;\r\n    color: #666666;\r\n}\r\n\r\n.btn-primary:disabled,\r\n.btn-primary[disabled] {\r\n    border: 1px solid #999999;\r\n    background-color: #cccccc;\r\n    color: #666666;\r\n}\r\n\r\n.btn-success:disabled,\r\n.btn-success[disabled] {\r\n    border: 1px solid #999999;\r\n    background-color: #cccccc;\r\n    color: #666666;\r\n}\r\n\r\n/*Vietnamese text optimization*/\r\n* {\r\n    text-rendering: optimizeLegibility;\r\n    -webkit-font-smoothing: antialiased;\r\n    -moz-osx-font-smoothing: grayscale;\r\n}\r\n\r\n/*Hyperlink*/\r\na {\r\n    color: #08c;\r\n}\r\n\r\na:hover {\r\n    color: #007bff;\r\n}\r\n\r\n/*Input type file*/\r\ninput[type=file],\r\ninput[type=file]+input {\r\n    display: inline-block;\r\n    font-size: 15px;\r\n    overflow: hidden;\r\n}\r\n\r\ninput[type=file]+input {\r\n    padding: 13px;\r\n    background-color: #08c;\r\n}\r\n\r\n::-webkit-file-upload-button {\r\n    -webkit-appearance: none;\r\n    background-color: #08c;\r\n    font-size: 15px;\r\n    padding: 9px;\r\n    color: white;\r\n    border: #08c;\r\n    border-radius: .25rem;\r\n    width: 100px;\r\n    font-weight: bold;\r\n}\r\n\r\n::-webkit-file-upload-button:hover {\r\n    background-color: #0069d9;\r\n    border-color: #0069d9;\r\n    cursor: pointer;\r\n}\r\n\r\n::-ms-browse {\r\n    background-color: #08c;\r\n    font-size: 15px;\r\n    padding: 9px;\r\n    border: #08c;\r\n}\r\n\r\ninput[type=file]::-ms-value {\r\n    border: none;\r\n}\r\n\r\n.read-only-dtpk {\r\n    background-color: white !important;\r\n}\r\n\r\n.table th {\r\n    padding: .5rem .4rem .5rem .4rem;\r\n}\r\n\r\n.table td {\r\n    padding: .4rem;\r\n}\r\n\r\n\r\n/*table {\r\n    border-collapse: collapse;\r\n}\r\n\r\n.table th {\r\n    padding: .5rem .4rem .5rem .4rem;\r\n}\r\n\r\ntable, th, td {\r\n    border: 1px solid #dee2e6;\r\n    vertical-align: top;\r\n    text-align: left;\r\n    padding: .4rem;\r\n}\r\n\r\n    table th {\r\n        background-color: #F2994A;\r\n        color: white;\r\n        font-weight: bold;\r\n    }*/"
          },
