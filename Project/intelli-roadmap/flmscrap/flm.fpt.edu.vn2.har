          "cookies": [],
          "content": {
            "size": 1654,
            "mimeType": "application/javascript",
            "text": "(function () {\r\n    var $body = $('body');\r\n\r\n    var maxChar = 255;\r\n    var delimiter = '<span class=\"delimiter\">...</span>';\r\n\r\n    $('.curricilum-description').each(function () {\r\n        var $description = $(this);\r\n\r\n        if ($description.text().length > maxChar) {\r\n            var shortDescription = $description.text().substring(0, maxChar);\r\n            var exDescription = $description.text().substring(maxChar, $description.text().length);\r\n\r\n            var description = shortDescription + delimiter\r\n                + '<span style=\"display: none; white-space: break-spaces;\">' + exDescription + '</span>'\r\n                + '<div href=\"#\" class=\"des-collapse-btn expand-icon\"></div>';\r\n\r\n            $description.html(description);\r\n        }\r\n    });\r\n\r\n    $body.on('click', '.expand-icon', function () {\r\n        var $description = $(this).closest('.curricilum-description');\r\n\r\n        if ($description) {\r\n            $description.find('span').show();\r\n            $description.find('span.delimiter').hide();\r\n\r\n            var $icon = $description.find('.expand-icon');\r\n            $icon.removeClass('expand-icon');\r\n            $icon.addClass('collapse-icon');\r\n        }\r\n    });\r\n\r\n    $body.on('click', '.collapse-icon', function () {\r\n        var $description = $(this).closest('.curricilum-description');\r\n\r\n        if ($description) {\r\n            $description.find('span').hide();\r\n            $description.find('span.delimiter').show();\r\n\r\n            var $icon = $description.find('.collapse-icon');\r\n            $icon.removeClass('collapse-icon');\r\n            $icon.addClass('expand-icon');\r\n        }\r\n    });\r\n})();"
          },
