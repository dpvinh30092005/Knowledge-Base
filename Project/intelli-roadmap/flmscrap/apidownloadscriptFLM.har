          "content": {
            "size": 219769,
            "mimeType": "text/html",
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /><link href=\"/Content/css?v=5SsskdAh3ChL4quPJSdTqyWDt4Uye5HAhSRdbwb5Vwg1\" rel=\"stylesheet\"/>\r\n<link href=\"../../../fonts/css/font-awesome.min.css\" rel=\"stylesheet\" /><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" /><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\" /><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=Source+Sans+Pro:wght@300;400;600;700&amp;display=swap\" rel=\"stylesheet\" /><link href=\"../../../Content/bootstrap.min.css\" rel=\"stylesheet\" /><link href=\"../../../Content/common.css\" rel=\"stylesheet\" /><link href=\"../../../bundles/customcss\" rel=\"stylesheet\" /><link href=\"../../../fonts/css/font-awesome.min.css\" rel=\"stylesheet\" /><link href=\"../../../fonts/css/Bootstrap-select-v1.13.14.css\" rel=\"stylesheet\" /><link href=\"../../../Content/toastr.min.css\" rel=\"stylesheet\" />\r\n    <style>\r\n        h1 {\r\n            font-size: 2em;\r\n        }\r\n\r\n        h2 {\r\n            font-size: 1.5em;\r\n        }\r\n\r\n        * {\r\n            font-family: 'Inter', 'Source Sans Pro', 'Segoe UI', 'Tahoma', 'Arial', 'Helvetica', sans-serif;\r\n            font-size: 16px;\r\n            font-weight: 400;\r\n            line-height: 1.5em;\r\n        }\r\n\r\n        body {\r\n            background: #fafafa;\r\n            padding: 0;\r\n        }\r\n\r\n        nav-bar {\r\n            position: fixed;\r\n            width: 100%\r\n        }\r\n\r\n        #sidebar a,\r\n        #sidebar a:hover,\r\n        #sidebar a:focus {\r\n            color: inherit;\r\n            text-decoration: none;\r\n            transition: all 0.3s;\r\n        }\r\n\r\n        /* Side Bar*/\r\n\r\n\r\n\r\n        #sidebar.sb-active {\r\n            margin-left: -300px;\r\n        }\r\n\r\n        .wrapper {\r\n            display: flex;\r\n            text-decoration: none;\r\n            transition: all 0.3s;\r\n        }\r\n\r\n\r\n        input, select {\r\n            font-size: inherit !important;\r\n            /*height: 33.5px !important;*/\r\n        }\r\n\r\n        table {\r\n            border-collapse: separate;\r\n            border-spacing: 0 0.8em;\r\n        }\r\n\r\n        .tbl-data {\r\n            border: 1px solid rgba(0,0,0,.05);\r\n        }\r\n\r\n            .tbl-data th {\r\n                font-weight: bold;\r\n                background-color: #F2994A !important;\r\n                color: white;\r\n            }\r\n\r\n            .tbl-data input[type=checkbox] {\r\n                width: 20px;\r\n            }\r\n\r\n        .tbl-detail tr td {\r\n            padding: 4px 5px 4px 5px;\r\n            border: 1px solid rgba(0,0,0,.05);\r\n        }\r\n\r\n        .tbl-checkbox label {\r\n            position: relative;\r\n            top: -11px;\r\n            left: 2px;\r\n        }\r\n\r\n        .max-with-fit {\r\n            max-width: fit-content;\r\n        }\r\n\r\n        textarea {\r\n            font-size: inherit !important;\r\n        }\r\n\r\n        #sidebar {\r\n            min-width: 300px;\r\n            max-width: 300px;\r\n            margin-top: 10px;\r\n            margin-left: 10px;\r\n            color: #fff;\r\n            transition: all 0.3s;\r\n            overflow-y: scroll;\r\n            height: 800px;\r\n            border-radius: 5px;\r\n            background-color: #F2994A;\r\n        }\r\n\r\n            #sidebar::-webkit-scrollbar {\r\n                width: 0;\r\n            }\r\n\r\n            #sidebar p {\r\n                padding: 15px;\r\n                background: #F2994A;\r\n                font-weight: bold;\r\n                font-size: 20px;\r\n            }\r\n\r\n            #sidebar ul.components {\r\n                padding: 20px 0;\r\n            }\r\n\r\n\r\n            #sidebar ul li a {\r\n                padding: 10px;\r\n                font-size: 1em;\r\n                display: block;\r\n                background-color: #f4a158;\r\n            }\r\n\r\n                #sidebar ul li a:hover {\r\n                    background: #d06e17;\r\n                }\r\n\r\n            #sidebar ul li.sb-active > a,\r\n            a[aria-expanded=\"true\"] {\r\n                color: #fff;\r\n            }\r\n\r\n        a[data-toggle=\"collapse\"] {\r\n            position: relative;\r\n        }\r\n\r\n        #navbarSupportedContent .dropdown-toggle::after {\r\n            display: block;\r\n            position: absolute;\r\n            top: 50%;\r\n            right: -15%;\r\n            transform: translateY(-50%);\r\n        }\r\n\r\n        .dropdown-toggle::after {\r\n            display: block;\r\n            position: absolute;\r\n            top: 50%;\r\n            right: 7%;\r\n            transform: translateY(-50%);\r\n        }\r\n\r\n        #sidebar ul ul a {\r\n            font-size: 0.9em !important;\r\n            padding-left: 30px !important;\r\n            background: #d29a68;\r\n        }\r\n\r\n        #content {\r\n            height: calc(100vh - 97px);\r\n            width: 100%;\r\n            padding: 20px;\r\n            transition: all 0.3s;\r\n        }\r\n\r\n        #ui-datepicker-div {\r\n            width: fit-content;\r\n        }\r\n\r\n        .menu-btn {\r\n            border: none;\r\n            background-color: #F2994A;\r\n        }\r\n\r\n            .menu-btn:focus {\r\n                outline: none;\r\n                box-shadow: none;\r\n            }\r\n\r\n        .btn-green:hover {\r\n            background-color: #009900;\r\n        }\r\n\r\n        .btn-success {\r\n            width: 70px;\r\n            height: 40px;\r\n            font-weight: bold;\r\n        }\r\n\r\n        #btn-home {\r\n            padding: 10px;\r\n            background-color: #28a745;\r\n            color: white;\r\n            font-weight: bold;\r\n        }\r\n\r\n            #btn-home:hover {\r\n                color: white;\r\n            }\r\n\r\n            #btn-home span {\r\n                position: relative;\r\n                top: 2px;\r\n                font-size: 15px;\r\n            }\r\n\r\n            #btn-home i {\r\n                position: relative;\r\n                top: 2px;\r\n            }\r\n\r\n        .btn-light {\r\n            border: 1px solid #d9cfcf;\r\n        }\r\n\r\n        #showModelNeed {\r\n            height: 33.5px;\r\n        }\r\n        /* Responsive adjustments */\r\n        @media (max-width: 1200px) {\r\n            #sidebar {\r\n                min-width: 260px;\r\n                max-width: 260px;\r\n            }\r\n        }\r\n        @media (max-width: 992px) {\r\n            h1 {\r\n                font-size: 1.6em;\r\n            }\r\n            .page-title {\r\n                position: static !important;\r\n                width: 100%;\r\n                text-align: center;\r\n                margin: 8px 0 0 0;\r\n            }\r\n            #btn-home {\r\n                height: 38px;\r\n                width: 80px;\r\n            }\r\n            #btn-home span {\r\n                font-size: 14px;\r\n            }\r\n            #sidebar {\r\n                position: fixed;\r\n                top: 97px;\r\n                left: 0;\r\n                height: calc(100vh - 97px);\r\n                z-index: 1030;\r\n            }\r\n            #content {\r\n                height: auto;\r\n                margin-top: 97px;\r\n            }\r\n        }\r\n        @media (max-width: 768px) {\r\n            h1 {\r\n                font-size: 1.3em;\r\n            }\r\n            .page-title {\r\n                position: static !important;\r\n                width: 100%;\r\n                text-align: center;\r\n                margin: 6px 0 0 0;\r\n            }\r\n            #language {\r\n                width: 110px !important;\r\n            }\r\n            /* Make long tables scrollable on small screens */\r\n            #content table {\r\n                display: block;\r\n                width: 100%;\r\n                overflow-x: auto;\r\n                -webkit-overflow-scrolling: touch;\r\n                white-space: nowrap;\r\n            }\r\n        }\r\n    </style>\r\n<title>\r\n\tFPT University Learning Materials\r\n</title></head>\r\n\r\n<body>\r\n    <form method=\"post\" action=\"./SyllabusDetails?sylID=13165\" id=\"form2\">\r\n<div class=\"aspNetHidden\">\r\n<input type=\"hidden\" name=\"__EVENTTARGET\" id=\"__EVENTTARGET\" value=\"\" />\r\n<input type=\"hidden\" name=\"__EVENTARGUMENT\" id=\"__EVENTARGUMENT\" value=\"\" />\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nvar theForm = document.forms['form2'];\r\nif (!theForm) {\r\n    theForm = document.form2;\r\n}\r\nfunction __doPostBack(eventTarget, eventArgument) {\r\n    if (!theForm.onsubmit || (theForm.onsubmit() != false)) {\r\n        theForm.__EVENTTARGET.value = eventTarget;\r\n        theForm.__EVENTARGUMENT.value = eventArgument;\r\n        theForm.submit();\r\n    }\r\n}\r\n//]]>\r\n</script>\r\n\r\n\r\n<script src=\"/WebResource.axd?d=pynGkmcFUV13He1Qd6_TZMrpL97guh2x_lfUiu-1_hlzlbl--S7Vc8swdj3bZMABH4j1Fn0pmI18V554x5p3Bw2&amp;t=638901788248157332\" type=\"text/javascript\"></script>\r\n\r\n\r\n<script src=\"../../../Scripts/WebForms/MsAjax/MicrosoftAjax.js\" type=\"text/javascript\"></script>\r\n<script src=\"../../../Scripts/WebForms/MsAjax/MicrosoftAjaxWebForms.js\" type=\"text/javascript\"></script>\r\n<script src=\"../../../Scripts/jquery-1.10.2.min.js\" type=\"text/javascript\"></script>\r\n<script src=\"../../../Scripts/popper.js\" type=\"text/javascript\"></script>\r\n<script src=\"../../../Scripts/bootstrap.min.js\" type=\"text/javascript\"></script>\r\n