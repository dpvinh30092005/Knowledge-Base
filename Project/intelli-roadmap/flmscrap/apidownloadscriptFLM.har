\n\r\n                    \r\n    <link href=\"../../../fonts/css/font-awesome.min.css\" rel=\"stylesheet\" />\r\n    <link href=\"../../../Content/font-face.css\" rel=\"stylesheet\" />\r\n    <link href=\"../../../Content/bootstrap.min.css\" rel=\"stylesheet\" />\r\n    <link href=\"../../../Content/common.css\" rel=\"stylesheet\" />\r\n    <style type=\"text/css\">\r\n        .auto-style2 {\r\n            width: 155px;\r\n        }\r\n\r\n        .auto-style3 {\r\n            width: 155px;\r\n            height: 24px;\r\n        }\r\n\r\n        /*Table*/\r\n        #gvSubs,\r\n        #table-detail,\r\n        #gvMaterial,\r\n        #gvLO,\r\n        #gvSchedule,\r\n        #gvAssessment {\r\n            border: 1px solid rgba(0, 0, 0, .05);\r\n        }\r\n\r\n            #gvSubs th {\r\n                font-weight: bold;\r\n                background-color: #F2994A;\r\n                color: white;\r\n            }\r\n\r\n            #gvMaterial th {\r\n                font-weight: bold;\r\n                background-color: #F2994A;\r\n                color: white;\r\n            }\r\n\r\n            #gvLO th {\r\n                font-weight: bold;\r\n                background-color: #F2994A;\r\n                color: white;\r\n            }\r\n\r\n            #gvSchedule th {\r\n                font-weight: bold;\r\n                background-color: #F2994A;\r\n                color: white;\r\n            }\r\n\r\n        /*Table*/\r\n        #gvCQ {\r\n            border: 1px solid rgba(0, 0, 0, .05);\r\n        }\r\n\r\n            #gvCQ th {\r\n                font-weight: bold;\r\n                background-color: #F2994A;\r\n                color: white;\r\n            }\r\n\r\n        .table-top {\r\n            border-collapse: separate;\r\n            border-spacing: 0 0.5em;\r\n        }\r\n\r\n        #gvAssessment th {\r\n            font-weight: bold;\r\n            background-color: #F2994A;\r\n            color: white;\r\n        }\r\n\r\n        .table-detail tr td {\r\n            padding: 6px 10px 6px 10px;\r\n        }\r\n\r\n        table-Schedule {\r\n            table-layout: auto;\r\n        }\r\n\r\n        /*Table*/\r\n        #gvPLO {\r\n            border: 1px solid rgba(0, 0, 0, .05);\r\n        }\r\n\r\n            #gvPLO th {\r\n                font-weight: bold;\r\n                background-color: #F2994A;\r\n                color: white;\r\n            }\r\n\r\n        .table-top {\r\n            border-collapse: separate;\r\n            border-spacing: 0 0.5em;\r\n        }\r\n\r\n        .plo,\r\n        table {\r\n            font-family: \"Trebuchet MS\", Arial, Helvetica, sans-serif;\r\n            border-collapse: collapse;\r\n            width: 100%;\r\n        }\r\n\r\n            .plo td,\r\n            #customers th {\r\n                border: 1px solid rgba(0, 0, 0, .05);\r\n                padding: 8px;\r\n            }\r\n\r\n            .plo tr:nth-child(even) {\r\n                background-color: #f2f2f2;\r\n            }\r\n\r\n            .plo tr:hover {\r\n                background-color: #ddd;\r\n            }\r\n\r\n            .plo th,\r\n            .header_PLO {\r\n                border: 1px solid rgba(0, 0, 0, .05);\r\n                padding-top: 12px;\r\n                padding-bottom: 12px;\r\n                padding-left: 6px;\r\n                padding-right: 6px;\r\n                text-align: center;\r\n                background-color: #F2994A;\r\n                color: white;\r\n                font-weight: bold;\r\n            }\r\n\r\n                .plo td,\r\n                .header_PLO td {\r\n                    text-align: center;\r\n                }\r\n\r\n        .textRedBold {\r\n            color: red;\r\n            font-weight: bold;\r\n        }\r\n    </style>\r\n    <div>\r\n\r\n        <h1 class=\"mb-4\">\r\n            Syllabus Details\r\n        </h1>\r\n        \r\n        <br />\r\n        \r\n        <table id=\"table-detail\" class=\"table-detail\" cellspacing=\"0\" rules=\"all\" border=\"1\"\r\n            style=\"border-collapse: collapse; width: 100%;\">\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Syllabus ID:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblSyllabusID\">13165</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style3\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Syllabus Name:\r\n                </td>\r\n                <td class=\"auto-style4\">\r\n                    <span id=\"lblSyllabusName\" style=\"font-weight:bold;\">Java Web Application Development_Phát triển ứng dụng Java web</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style3\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">Syllabus English:</td>\r\n                <td class=\"auto-style4\">\r\n                    <span id=\"lblSyllabusNameEnglish\" style=\"font-weight:bold;\">Java Web Application Development</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Subject Code:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblSubjectCode\" style=\"font-weight:bold;\">PRJ301</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    NoCredit:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblNoCredit\">3</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Degree Level:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblDegreeLevel\">Bachelor</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Time Allocation:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblTimeAllocation\">Study hour (150h) = 45h contact hours + 1h final exam + 85' practical exam + 102.6h self-study</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Pre-Requisite:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblPreRequisite\">DBI202, PRO192</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Description:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblDescription\">By the end of this course Students will be able to:\r<br/>a) Knowledge: (what will students know?)\r<br/>• Understand the core technologies of Java web programming:\r<br/>- Servlet and JSP\r<br/>- Scope of sharing state (session, application, request,page)\r<br/>• Know how to develop and deploy your own websites using Java\r<br/>• Understand and be able to apply MVC architecture for the web\r<br/>- Learning how to apply JPA in websites using Java\r<br/>• Learning how to apply AI in your own website using Java\r<br/>b) Skills: (what will students be able to do?)\r<br/>• Basic Web application development applying MVC Design Pattern using Servlet/Filter as Controller \r<br/>• Creating a simple Web Application demo using JPA</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    StudentTasks:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblStudentTask\">- Attend at least 80% of contact hours in order to be accepted to the final examination\r<br/>- Actively participate in class activities\r<br/>- Fulfil tasks given by intructor after class\r<br/>- Use their own laptop in class only for learning purpose\r<br/>- Read the textbook in advance\r<br/>- Promptly access to the https://flm.fpt.edu.vn/ for up-to-date course information</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Tools:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblTools\">Web server application :Tomcat 9 or higher\r<br/>IDE: Netbeans 13 or higher (as defined by the subject leader)\r<br/>Java EE: 1.8 or higher\r<br/>MS SQL Server 2019 or higher</span>\r\n                </td>\r\n            </tr>\r\n            <tr id=\"trScoringScale\">\r\n\t<td class=\"auto-style2\" align=\"right\" style=\"text-align: right; table-layout: auto;\">\r\n                    Scoring Scale:\r\n                </td>\r\n\t<td class=\"auto-style6\">\r\n                    <span id=\"lblScoringScale\">10</span>\r\n                </td>\r\n</tr>\r\n\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    DecisionNo MM/dd/yyyy:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblDecisionNo\">932/QĐ-ĐHFPT dated 08/22/2025</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    IsApproved:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblIsApproved\" style=\"font-weight:bold;\">True</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    Note:\r\n                </td>\r\n                <td class=\"auto-style6\">\r\n                    <span id=\"lblNote\"></span>\r\n                </td>\r\n            </tr>\r\n            <tr id=\"trMinAvgMarkToPass\">\r\n\t<td class=\"auto-style3\" align=\"right\" style=\"text-align: right; table-layout: auto;\">\r\n                    MinAvgMarkToPass:\r\n                </td>\r\n\t<td class=\"auto-style4\">\r\n                    <span id=\"lblMinAvgMarkToPass\">5</span>\r\n                </td>\r\n</tr>\r\n\r\n            <tr>\r\n                <td class=\"auto-style3\" align=\"right\"\r\n                    style=\"text-align: right; table-layout: auto;\">\r\n                    IsActive:\r\n                </td>\r\n                <td class=\"auto-style4\">\r\n                    <span id=\"lblIsActive\">True</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"auto-style2\" align=\"right\"\r\n         