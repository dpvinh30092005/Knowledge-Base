  <div>\r\n\t<table class=\"auto-style2 table table-striped tbl-data\" cellspacing=\"0\" rules=\"all\" border=\"1\" id=\"gvSchedule\" style=\"width:100%;border-collapse:collapse;\">\r\n\t\t<tr>\r\n\t\t\t<th scope=\"col\">Session</th><th scope=\"col\">Topic</th><th scope=\"col\">Learning-Teaching Type</th><th scope=\"col\">LO</th><th scope=\"col\">ITU</th><th scope=\"col\">Student Materials</th><th scope=\"col\">S-Download</th><th scope=\"col\">Student&#39;s Tasks</th><th scope=\"col\">URLs</th>\r\n\t\t</tr><tr>\r\n\t\t\t<td>1</td><td>Introduction to java web application<br/>+ The core and basic of Java web server technologies<br/>+ Web design vs server technologies</td><td>Offline</td><td>LO1</td><td>IT</td><td class=\"product\">Textbook: Chapter 1 &amp; 2</td><td><a class=\"ContainSLink\" href=\"../../../download/12674/S/1_PRJ301.zip\">PRJ301</a></td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>2</td><td>Setup Environment :<br/>JDK: 1.8 or higher<br/>Servlet container: Tomcat 10 or higher<br/>Intergrate Netbeans 13 with the web container.</td><td>Offline</td><td>LO1</td><td>TU</td><td class=\"product\">Textbook: Chapter 1 &amp; 2</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>3</td><td>Creating/Building the first application:<br/>Learn to create Servlet<br/>Guide to Using Prompt Engineering Effectively with Java Web</td><td>Offline</td><td>LO1; LO08</td><td>TU</td><td class=\"product\">Textbook: Chapter 1 &amp; 2</td><td>&nbsp;</td><td>Read textbook, do exercise<br/>Students learn how to use prompt engineering, which is essential when integrating AI-driven solutions into Java Web applications. When using large language models (LLMs) like OpenAI’s models, a well-structured prompt can significantly improve the accuracy and relevance of AI-generated responses<br/>- Do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>4</td><td>Learn to create JSP<br/>Deploy the web application</td><td>Offline</td><td>LO1</td><td>TU</td><td class=\"product\">Textbook: Chapter 1 &amp; 2</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>5</td><td>Wiritting the First Servlet<br/>Create a servlet<br/>+ Create a servlet class<br/>+ Configure servlet for deployment</td><td>Offline</td><td>LO2</td><td>TU</td><td class=\"product\">Textbook: Chapter 3</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>6</td><td>Work with request and response objects<br/>+ Understanding DoGet and DoPost</td><td>Offline</td><td>LO2</td><td>TU</td><td class=\"product\">Textbook: Chapter 3</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>7</td><td>+ Using parameter to accept form submition &amp; query string<br/>+ Response text content to client</td><td>Offline</td><td>LO2</td><td>TU</td><td class=\"product\">Textbook: Chapter 3</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>8</td><td>Using AI in Netbeans24</td><td>Offline</td><td>LO1</td><td>TU</td><td class=\"product\">Textbook: Chapter 3</td><td>&nbsp;</td><td>Students will study how to use Jeddict AI assisstant in Netbeans</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>9</td><td>Practice Classwork 1</td><td>Offline</td><td>LO2</td><td>TU</td><td class=\"product\">Textbook: Chapter 3</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>10</td><td>Practice Classwork 1</td><td>Offline</td><td>LO2</td><td>TU</td><td class=\"product\">Textbook: Chapter 3</td><td>&nbsp;</td><td>Read textbook, do exercise</td><td>&nbsp;</td>\r\n\t\t</tr><tr>\r\n\t\t\t<td>11</td><td>Web Application Interacting with Database<br/>+ JDBC Introduction<br/>+ Types of JDBC Drivers</td><td>Offline</td><td>LO3</td><td>IT</td><td class=\"product\">http://docs.oracle.com/javase/tutorial/jdbc/index.html</td><td>&