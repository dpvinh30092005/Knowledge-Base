# Copy to .env and fill in real values. .env is gitignored - never commit secrets.

# Scraper / service
THREAD_SLEEP=
TOPCV_TARGET=
ITVIEC_TARGET=
# Query fragment asking ITviec for newest-first, e.g. the one behind its own sort control.
# Leave empty and the scraper collects ITviec's default promoted order instead.
ITVIEC_SORT_QUERY=
LINKEDIN_TARGET=
MAX_SCRAPE_LIMIT=

# Shared secret the Spring backend sends to authenticate to this service
SERVICE_API_KEY=

# LLM (OpenAI-compatible). Leave LLM_API_KEY empty to disable AI and fall back
# to keyword matching.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# FLM (FPT Learning Management) scraper. FLM_COOKIE is the full Cookie header from
# a logged-in flm.fpt.edu.vn session (via FEID). FLM_USER_AGENT should match the
# browser that session came from (devtools Console: navigator.userAgent).
FLM_BASE_URL=
FLM_COOKIE=
FLM_DELAY_MS=
FLM_USER_AGENT=
